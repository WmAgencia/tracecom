{
  "manifest_version": 3,
  "name": "TRACE/CON — Sinal de Mercado",
  "version": "0.2.0",
  "description": "Sinal de análise (BUY/SELL/WAIT) com probabilidade e ativo operado, ao lado da sua corretora. NÃO executa ordens — você decide.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://www.tradingview.com/*",
    "https://br.tradingview.com/*",
    "https://www.binance.com/*",
    "https://www.binance.com.br/*",
    "https://app.exodus.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://br.tradingview.com/*",
        "https://www.binance.com/*",
        "https://www.binance.com.br/*",
        "https://app.exodus.com/*"
      ],
      "js": ["content.js"],
      "css": ["downbar.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "TRACE/CON — abrir configurações"
  }
}