# ============================================================
# TRACECON - Variáveis de ambiente (template)
# Copie para .env e preencha. NUNCA commite o .env real em
# repositórios públicos.
# ============================================================

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# --- OpenCode Go (camada PRINCIPAL de IA, PADRÃO) -----------
# API OpenAI-compatible: POST {OPENCODE_GO_BASE_URL}/chat/completions.
# A chave é usada SOMENTE server-side; nunca é logada/serializada.
AI_PROVIDER=openCodeGo
AI_MODEL=deepseek-v4.1-flash
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# Limite de output tokens por chamada (default 8192).
OPENCODE_GO_MAX_TOKENS=8192
# Timeout por chamada em ms (default 60000).
OPENCODE_GO_TIMEOUT_MS=60000

# --- Anthropic (LEGADO; NÃO é mais default) -----------------
# Só é usado com AI_PROVIDER=anthropic explícito. Mantido para
# re-habilitação pontual; sem a flag, a chave é ignorada.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_EXTENDED_OUTPUT=true
ANTHROPIC_THINKING_ENABLED=true
ANTHROPIC_THINKING_BUDGET=8000

# --- Fable/Nexxus vision (LEGADO) ---------------------------
# Só é instanciado quando FABLE_API_KEY existe; a extensão nunca
# recebe este valor. O caminho padrão de visão é OpenCode Go (relay).
FABLE_API_KEY=
FABLE_BASE_URL=https://api.nexxus-pro.site
FABLE_MODEL=deepseek-v4.1-flash

# --- Banco de dados relacional (node:sqlite) ----------------
# Caminho do arquivo de banco. Use ':memory:' para testes.
DATABASE_PATH=tracecon.db

# Modo de execução do motor de dados de mercado.
# 'noop'     -> nenhum provider conectado, todas as leituras retornam DATA_UNAVAILABLE
# 'mocked'   -> fornece dados sintéticos MARCADEVELMENTE (apenas testes, NÃO produção)
# 'binance'  -> conector real da Binance (REST público, sem chave; WebSocket p/ streaming)
#               Dados reais de mercado: klines/tickers/trades. NÃO é corretora.
# 'iqoption' -> recebe apenas frames de mercado inbound normalizados pela
#               extensão, a partir da sessão que o usuário abriu. Não armazena
#               senha/cookie/SSID e não envia ordens.
MARKET_DATA_MODE=auto
# auto seleciona somente Forex real: OANDA quando configurado, depois Yahoo
# Finance Chart público; se nenhum feed responder, retorna PROVIDER_UNAVAILABLE.

# --- Forex real via OANDA v20 (opcional) --------------------
# Sem ambas as credenciais, /api/forex/scan responde 503 e jamais gera dados.
# Use a conta practice antes de qualquer uso em produção.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com/v3

# --- Deploy (Railway/Vercel) ---------------------------------
# Porta do servidor HTTP long-running (Railway define PORT; default 8788).
HTTP_PORT=8788
# Token opcional p/ proteger /api/* (server-side). Nunca exponha no browser.
TRACECON_API_TOKEN=

# --- Segundo Cerebro / Obsidian (Fase 6) ---------------------
# LOCAL_FS: caminho do vault Obsidian (copia server-side autorizada).
# O TraceCom le/escreve SOMENTE em TraceCom/ e nunca promove nada sozinho:
# "00 - Core Brain" e "15 - Validated Knowledge" exigem Promotion Gate.
SECOND_BRAIN_VAULT_PATH=
# REST (alternativa para producao): API de conhecimento do Segundo Cerebro.
# Credenciais ficam somente server-side; nunca em log, audit ou frontend.
SECOND_BRAIN_BASE_URL=
SECOND_BRAIN_TOKEN=

# --- Supabase (opcional, multi-tenancy futura) ----------------
# Supabase é usado como Postgres gerenciado. A Tracecon usa SQLite local nesta
# fase; as credenciais Supabase seriam usadas num futuro adapter de repositório.
# NUNCA commitar valores reais.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
