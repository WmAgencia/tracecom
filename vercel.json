{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/http.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/http.ts" },
    { "source": "/health", "destination": "/api/http.ts" },
    { "source": "/extension/(.*)", "destination": "/api/http.ts" }
  ]
}